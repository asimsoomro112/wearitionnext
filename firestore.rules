rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && 
        (request.auth.token.email == 'asimsoomro195@gmail.com' || 
         request.auth.token.email == 'asimsoomro112@gmail.com' || 
         request.auth.token.email == 'admin@wearition.store' ||
         request.auth.token.email == 'admin@wearition.com' ||
         request.auth.uid == 'ruPbxf2c0RZD85CTmW9Aa2iMul83'); 
    }

    // Settings: Publicly readable, admin writable.
    // Contents are public store config only (shipping/tax/collections,
    // homepage sections, price backup) — never secrets.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: Publicly readable if published, admin writable.
    // SECURITY (2026-11-23): the old anonymous stock-only update let any
    // visitor set any product's stock to any value. Stock now moves
    // server-side only (order create/cancel via /api/orders and
    // /api/cancel-order with the Admin SDK) — no client stock writes.
    match /products/{productId} {
      allow read: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // Users: Only owner or admin
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Orders: SECURITY (2026-11-23).
    //  - get was `if true`: anyone with an order ID could read the full
    //    order (name, email, phone, address, payment screenshot) and the
    //    track page never checked the email it read from the URL. Now
    //    owner/admin only; guests track via POST /api/track-order
    //    (orderId + email, verified server-side with the Admin SDK).
    //  - create was `if true`: anyone could create orders with arbitrary
    //    client-computed prices/totals. Orders are now created server-side
    //    only (POST /api/orders — catalogue prices re-verified, stock
    //    decremented atomically). No client creates.
    //  - owner cancel now also requires the order to be pending (was: any
    //    status could be flipped to cancelled, restoring stock).
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // Newsletter: anyone can subscribe (doc id is their own email);
    // only admins can read the list. (No signup form uses this today;
    // the collection is dormant.)
    match /subscribers/{email} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // OTPs + contact messages: NO client access by design (default deny).
    // OTP codes live server-side only (Admin SDK, /api/auth/*) — a client
    // rule here would expose the codes. Contact messages go by email only.
    match /otps/{otpId} {
      allow read, write: if false;
    }
    match /messages/{messageId} {
      allow read, write: if false;
    }

    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
