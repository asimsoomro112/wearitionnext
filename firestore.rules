rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && 
        (request.auth.token.email == 'asimsoomro195@gmail.com' || 
         request.auth.token.email == 'admin@wearition.store' ||
         request.auth.uid == 'ruPbxf2c0RZD85CTmW9Aa2iMul83'); 
    }

    // Settings: Publicly readable, admin writable
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: Publicly readable if published, admin writable
    match /products/{productId} {
      allow read: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Users: Only owner or admin
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Orders: Owner by userId OR email, admin can do anything
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.email == request.auth.token.email || 
        (resource.data.userId != null && resource.data.userId == request.auth.uid) || 
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Newsletter
    match /subscribers/{email} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
