rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && 
        (request.auth.token.email == 'asimsoomro195@gmail.com' || 
         request.auth.token.email == 'admin@wearition.com'); 
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['user', 'admin'] &&
             data.createdAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'totalAmount', 'status', 'items', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.totalAmount is number &&
             data.status in ['pending', 'processing', 'shipped', 'delivered'] &&
             data.items is list && data.items.size() <= 100 &&
             data.createdAt == request.time;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['title', 'brand', 'price', 'stock', 'category', 'images', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.brand is string && data.brand.size() <= 100 &&
             data.price is number &&
             data.stock is number &&
             data.images is list && data.images.size() <= 20 &&
             data.category is string && data.category.size() <= 100 &&
             data.createdAt == request.time;
    }

    // Collections
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming()) && incoming().role == 'user';
      allow update: if isSignedIn() && request.auth.uid == userId && (
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'shippingAddress']))
      );
    }

    match /products/{productId} {
      allow get: if existing().isPublished == true || isAdmin();
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && incoming().status == 'pending';
      allow update: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
