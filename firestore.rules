rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && 
        (request.auth.token.email == 'asimsoomro195@gmail.com' || 
         request.auth.token.email == 'asimsoomro112@gmail.com' || 
         request.auth.token.email == 'admin@wearition.store' ||
         request.auth.token.email == 'admin@wearition.com' ||
         request.auth.uid == 'ruPbxf2c0RZD85CTmW9Aa2iMul83'); 
    }

    // Settings: Publicly readable, admin writable
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: Publicly readable if published, admin writable
    // Customers are allowed to update ONLY the 'stock' field during checkout
    match /products/{productId} {
      allow read: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']);
    }

    // Users: Only owner or admin
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Orders: Only the order owner (by email or userId) can read their own order.
    // Admins can read/update all. Anyone can create (for guest checkout).
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if true; 
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // Newsletter
    match /subscribers/{email} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
